# LiveKit Connection Settings
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Distinct worker dispatch name. Connects/dispatches to the hosted worker on LiveKit Cloud (usually outbound-caller-prod)
LIVEKIT_AGENT_NAME=outbound-caller-prod
# Local worker port is deprecated since we use the LiveKit Cloud worker
# LIVEKIT_AGENT_HTTP_PORT=8081

# Remote Frappe / ERPNext Server Connection
FRAPPE_SITE_URL=http://lsa-test-one.localhost
FRAPPE_API_KEY=your-frappe-api-key
FRAPPE_API_SECRET=your-frappe-api-secret

# AI Model Keys (Depending on your choice of voice agent config)
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Telephony/SIP Settings (Optional, for calling/transfers)
# LiveKit SIP Outbound Trunk ID from LiveKit Cloud → Telephony → SIP trunks (e.g. ST_xxxx), NOT a phone number
OUTBOUND_TRUNK_ID=your-livekit-sip-trunk-id
VOBIZ_SIP_DOMAIN=your-sip-domain.vobiz.com
DEFAULT_TRANSFER_NUMBER=your-default-transfer-number

# Recording lookup settings. Recording URLs come from the Vobiz API, not LiveKit egress.
# Keep real Vobiz credentials out of git and expose only derived recording URLs through the Call API.
# VOBIZ_API_BASE_URL=https://api.vobiz.ai/api/v1
# VOBIZ_AUTH_ID=your-vobiz-auth-id
# VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
# VOBIZ_RECORDING_FORMAT=mp3
# VOBIZ_RECORDING_CHANNEL_TYPE=stereo

# Call Control API Settings (for Hermes / external AI call orchestration)
# Generate with: openssl rand -hex 32
CALL_API_TOKEN=your-long-random-call-api-token
CALL_API_ALLOWED_COUNTRY_PREFIXES=+91
CALL_API_DEFAULT_COUNTRY_CODE=+91
CALL_API_MAX_PURPOSE_CHARS=300
# Required. Use the Dokploy Postgres connection string here, not a committed secret.
# Set the same value on the Call API and every worker deployment.
# CALL_API_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional alias used by worker/API if CALL_API_DATABASE_URL is absent.
# CALL_STATUS_DATABASE_URL=postgresql://user:password@host:5432/database

# Hermes plugin / external AI client settings
LIVEKIT_CALL_API_URL=http://127.0.0.1:8000
LIVEKIT_CALL_API_TOKEN=your-long-random-call-api-token

# Google Sheets Calling Automation
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
GOOGLE_SHEETS_CREDS_PATH=.google_sheets_creds.json

