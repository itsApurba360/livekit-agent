# LiveKit Connection Settings
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Remote Frappe / ERPNext Server Connection
FRAPPE_SITE_URL=http://lsa-test-one.localhost
FRAPPE_API_KEY=your-frappe-api-key
FRAPPE_API_SECRET=your-frappe-api-secret

# AI Model Keys (Depending on your choice of voice agent config)
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Telephony/SIP Settings (Optional, for calling/transfers)
# LiveKit SIP Outbound Trunk ID from LiveKit Cloud → Telephony → SIP trunks (e.g. ST_xxxx), NOT a phone number
OUTBOUND_TRUNK_ID=your-livekit-sip-trunk-id
VOBIZ_SIP_DOMAIN=your-sip-domain.vobiz.com
DEFAULT_TRANSFER_NUMBER=your-default-transfer-number

# Call Control API Settings (for Hermes / external AI call orchestration)
# Generate with: openssl rand -hex 32
CALL_API_TOKEN=your-long-random-call-api-token
CALL_API_ALLOWED_COUNTRY_PREFIXES=+91
CALL_API_DEFAULT_COUNTRY_CODE=+91
CALL_API_MAX_PURPOSE_CHARS=300
# Optional. Defaults to ./call_control.sqlite3. API and worker must share this path for call status updates.
# CALL_API_DB_PATH=/absolute/path/to/call_control.sqlite3

# Hermes plugin / external AI client settings
LIVEKIT_CALL_API_URL=http://127.0.0.1:8000
LIVEKIT_CALL_API_TOKEN=your-long-random-call-api-token
